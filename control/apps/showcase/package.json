    "next": "16.3.6",
    "postgres": "^3.4.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.34.5",
    "simple-icons": "16.32.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
