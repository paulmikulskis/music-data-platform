# Music Data Platform inputs. Your operator-supplied secret manager
# is the home for every value here. Copy this file to inputs/inputs.env
# only for a local override; inputs.env is gitignored and is never committed. Key names are used
# verbatim by ops/preflight.sh and by downstream code. Format: KEY=value, one per line; wrap a
# value in double quotes when it contains spaces.

# ----- Fly -----
# Fly API token with membership in your Fly organization. Supplied by the Fly organization owner. `fly tokens create org -o <FLY_ORG>` (preflight falls back to the access_token in ~/.fly/config.yml when unset)
FLY_API_TOKEN=
# Slug of the operator-owned Fly organization. Supplied by the Fly organization owner. `fly orgs create <slug>`, then add the org card at https://fly.io/dashboard/<slug>/billing
FLY_ORG=
# Fly region for every MDP app and volume. Operator choice; default ewr. `fly platform regions`
FLY_REGION=

# ----- Cloudflare R2 -----
# Cloudflare account id that owns the bucket; the S3 endpoint derives as https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com. Supplied by the Cloudflare account admin. https://dash.cloudflare.com -> R2 -> Overview (account id in the right rail)
R2_ACCOUNT_ID=
# R2 bucket that holds the lake. Supplied by the Cloudflare account admin. https://dash.cloudflare.com -> R2 -> Create bucket
R2_BUCKET=
# R2 API token access key id (Object Read & Write, scoped to R2_BUCKET). Supplied by the Cloudflare account admin. https://dash.cloudflare.com -> R2 -> Manage R2 API Tokens
R2_ACCESS_KEY_ID=
# R2 API token secret, issued together with R2_ACCESS_KEY_ID and shown once. Same source as above.
R2_SECRET_ACCESS_KEY=

# ----- dbt Cloud -----
# dbt Cloud host. Default cloud.getdbt.com; change only for a regional or single-tenant instance. https://docs.getdbt.com/docs/cloud/about-cloud/access-regions-ip-addresses
DBT_CLOUD_HOST=
# dbt Cloud account id. Supplied by the dbt Cloud account admin. The number in https://cloud.getdbt.com/settings/accounts/<id>
DBT_CLOUD_ACCOUNT_ID=
# dbt Cloud project id of the MDP project. Supplied by the dbt Cloud account admin. The number in https://cloud.getdbt.com/deploy/<account>/projects/<id>/
DBT_CLOUD_PROJECT_ID=
# dbt Cloud environment id of the production (deploy) environment. Supplied by the dbt Cloud account admin. https://cloud.getdbt.com/deploy/<account>/projects/<project>/environments -> the environment's URL
DBT_CLOUD_ENV_ID_PROD=
# dbt Cloud environment id of the CI environment. Supplied by the dbt Cloud account admin. Same page as DBT_CLOUD_ENV_ID_PROD.
DBT_CLOUD_ENV_ID_CI=
# dbt Cloud service token with the Job Admin and Webhooks permission sets. Supplied by the dbt Cloud account admin. https://cloud.getdbt.com/settings/accounts/<account>/pages/service-tokens
DBT_CLOUD_TOKEN=

# ----- secret store -----
# Adapter namespace that holds these inputs. Default music-data-platform; choose a name supported by your adapter.
SECRET_STORE_PROJECT=
# Adapter configuration to read. Default dev; choose a name supported by your adapter.
SECRET_STORE_CONFIG=
# Optional adapter credential; authentication when unset is defined by your operator-supplied secret_store implementation.
SECRET_STORE_TOKEN=

# ----- LiteLLM -----
# Base URL of an operator-run LiteLLM proxy (not included). Optional. https://<app>.example.invalid
LITELLM_BASE_URL=
# LiteLLM proxy admin (master) key, the LITELLM_MASTER_KEY the proxy was booted with. Same source as LITELLM_BASE_URL.
LITELLM_ADMIN_KEY=

# ----- Grafana Cloud -----
# OTLP endpoint URL of the Grafana Cloud stack. Supplied by the Grafana Cloud stack admin. https://grafana.com/orgs/<org>/stacks -> the stack -> OpenTelemetry -> Configure
OTLP_ENDPOINT=
# Full Authorization header value for OTLP, e.g. "Basic <base64 of instanceId:token>". Supplied by the Grafana Cloud stack admin. Same page (Generate API token).
OTLP_AUTH_HEADER=

# ----- Clerk -----
# Clerk secret key (sk_test_* or sk_live_*). Supplied by the Clerk application admin. https://dashboard.clerk.com -> the MDP app -> Configure -> API keys
CLERK_SECRET_KEY=
# Clerk publishable key (pk_test_* or pk_live_*). Supplied by the Clerk application admin. Same page as CLERK_SECRET_KEY.
CLERK_PUBLISHABLE_KEY=

# Path to a CSV of resolved accounts used as fixtures. Columns platform,platform_account_id,handle,display_name; display_name is optional (the column may be absent or empty), the other three are required and every row must have the header's width; platform is fixture. Default inputs/fixture_targets.csv; the file is operator data and stays out of git. Supplied by the operator.
MDP_FIXTURE_TARGETS=

# ----- Billboard -----
# No credential. The probe is an HTTP GET of https://www.billboard.com/charts/hot-100/ expecting 200; the function reads the same public chart pages through the `billboard` Python package.

# ----- Budgets (cents; the defaults are acceptable and preflight reports "default" when unset) -----
# Global spend budget per cycle, in cents. Default 10000. Operator choice.
MDP_BUDGET_GLOBAL_CENTS=
# Per-streamline spend budget per cycle, in cents. Default 2000. Operator choice.
MDP_BUDGET_STREAMLINE_CENTS=
# Per-LLM-step spend budget, in cents. Default 500. Operator choice.
MDP_BUDGET_LLM_STEP_CENTS=
# Hard ceiling in cents; every streamline stops above it. Default 50000. Operator choice.
MDP_BUDGET_CEILING_CENTS=

# ----- Snowflake trial (only; preflight checks presence and never connects) -----
# Snowflake account identifier (<org>-<account>). Supplied by whoever opens the trial. https://signup.snowflake.com/
SNOWFLAKE_ACCOUNT=
# Snowflake user of the trial. Same source as SNOWFLAKE_ACCOUNT.
SNOWFLAKE_USER=
# Snowflake password of that user. Same source as SNOWFLAKE_ACCOUNT.
SNOWFLAKE_PASSWORD=
# Snowflake warehouse (a trial ships COMPUTE_WH). Same source as SNOWFLAKE_ACCOUNT.
SNOWFLAKE_WAREHOUSE=
# Snowflake database for the trial; create it in Snowsight. Same source as SNOWFLAKE_ACCOUNT.
SNOWFLAKE_DATABASE=
# Snowflake role (a trial grants ACCOUNTADMIN). Same source as SNOWFLAKE_ACCOUNT.
SNOWFLAKE_ROLE=

# ----- GitHub -----
# GitHub repository in owner/name form. Default paulmikulskis/music-data-platform. `gh repo view paulmikulskis/music-data-platform --json name`
GITHUB_REPO=
