  {
    "room": "Draft / frozen rule picks",
    "id": "rule_picks",
    "relation": "marts.mart_arrivals_current",
    "columns": [
      "artist_stage",
      "age_class",
      "discovery_entries",
      "market_count",
      "entered_lists",
      "list_reach_tier",
      "movement_list",
      "rank"
    ],
    "sql": "WITH candidates AS (SELECT value AS c FROM jsonb_array_elements($1::text::jsonb)), rules AS (SELECT value AS r FROM jsonb_array_elements($2::text::jsonb)), matches AS (\n SELECT c->>'song_key' AS song_key,r->>'id' AS rule_id,(r->>'limit_per_draft')::int AS pick_limit,\n row_number() OVER (PARTITION BY r->>'id' ORDER BY CASE c->>'movement_list' WHEN 'new_entries' THEN 0 WHEN 'established_entries' THEN 1 WHEN 'catalog_entries' THEN 2 WHEN 'unplaced' THEN 3 ELSE 4 END,(c->>'rank')::bigint,md5($3::text || ':' || (c->>'song_key'))) AS n\n FROM candidates CROSS JOIN rules WHERE NOT EXISTS (\n SELECT 1 FROM jsonb_array_elements(r->'conditions') condition WHERE NOT coalesce(CASE condition->>'field'\n WHEN 'artist_stage' THEN c->>'artist_stage'=condition->>'value'\n WHEN 'age_class' THEN c->>'age_class'=condition->>'value'\n WHEN 'discovery_entries_at_least' THEN (c->>'discovery_entries')::int >= (condition->>'value')::int\n WHEN 'markets_at_least' THEN (c->>'market_count')::int >= (condition->>'value')::int\n WHEN 'lists_at_least' THEN (c->>'entered_lists')::int >= (condition->>'value')::int\n WHEN 'reach_tier_at_most' THEN (c->>'list_reach_tier')::int <= (condition->>'value')::int\n ELSE false END,false)))\n SELECT song_key,jsonb_agg(rule_id ORDER BY rule_id) AS rule_ids FROM matches WHERE n<=pick_limit GROUP BY song_key ORDER BY song_key"
  },
