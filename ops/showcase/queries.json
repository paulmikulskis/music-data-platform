  {
    "room": "Team / try a question",
    "id": "team_shazam_cities",
    "relation": "marts.mart_shazam_chart_daily",
    "columns": [
      "title_text",
      "artist_text",
      "city",
      "country",
      "chart_date",
      "apple_song_id"
    ],
    "sql": "WITH firsts AS (\n  SELECT s.apple_song_id, s.city, s.country, min(s.chart_date) AS first_day,\n    min(s.title_text) AS title_text, min(s.artist_text) AS artist_text\n  FROM marts.mart_shazam_chart_daily s\n  WHERE s.city IS NOT NULL AND s.city <> '' AND s.apple_song_id IS NOT NULL\n  GROUP BY 1, 2, 3)\nSELECT f.title_text, f.artist_text, f.city, f.country, f.first_day::text AS first_day,\n  (SELECT k.song_key FROM explore_intermediate.int_song_key__daily k\n    WHERE k.platform = 'apple' AND k.platform_track_id = f.apple_song_id\n    ORDER BY k.song_key LIMIT 1) AS song_key\nFROM firsts f\nWHERE f.first_day >= (now() AT TIME ZONE 'UTC')::date - 6\nORDER BY f.first_day DESC, f.title_text, f.city\nLIMIT 5"
  },
